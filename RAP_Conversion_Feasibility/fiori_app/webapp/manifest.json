{
  "_version": "1.65.0",
  "sap.app": {
    "id": "ccbji.otc.stlmnt",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/ccbji/fsv_stlmnt_srvb_v4/srvd/ccbji/fsv_stlmnt_srvd/0001/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "SettlementDetail-display": {
          "semanticObject": "SettlementDetail",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.mdc": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ccbji.otc.stlmnt.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "js": []
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "SettlementDetailList",
          "target": "SettlementDetailList"
        },
        {
          "pattern": "SettlementDetail({key}):?query:",
          "name": "SettlementDetailObjectPage",
          "target": "SettlementDetailObjectPage"
        }
      ],
      "targets": {
        "SettlementDetailList": {
          "type": "Component",
          "id": "SettlementDetailList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "SettlementDetail",
              "variantManagement": "Page",
              "initialLoad": "Disabled",
              "navigation": {
                "SettlementDetail": {
                  "detail": {
                    "route": "SettlementDetailObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "growingThreshold": 500,
                    "growingMode": "Scroll"
                  }
                }
              }
            }
          }
        },
        "SettlementDetailObjectPage": {
          "type": "Component",
          "id": "SettlementDetailObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "SettlementDetail"
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "ccbji.otc.stlmnt.ext.controller.ListReportExt"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "ccbji.otc.stlmnt.ext.controller.ObjectPageExt"
          }
        }
      }
    }
  }
}
