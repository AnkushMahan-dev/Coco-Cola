@Metadata.layer: #CORE
@UI: { headerInfo: { typeName:       'Settlement Detail',
                     typeNamePlural: 'Settlement Details',
                     title:          { type: #STANDARD, value: 'ShipmentNo' } } }
annotate entity /CCBJI/I_FSV_STLMNT_DTL with
{
  @UI.facet: [ { id: 'Gen', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                 label: 'Settlement Detail', position: 10 } ]

  @UI.hidden: true
  RowKey;

  @UI: { lineItem: [ { position: 502, label: 'Seq No.' } ], identification: [ { position: 502, label: 'Seq No.' } ] }
  Seqno;

  // Explicit column labels on every lineItem: on a CUSTOM ENTITY the element
  // @EndUserText.label does not reliably become the MDC table column header,
  // so each header text is set here directly (that was the "blank Status /
  // blank column" cause on the list page).

  // ---- Report Mode : the driving dropdown (classic radio group) ----------
  @UI: { lineItem: [ { position: 10, label: 'Report Mode', importance: #HIGH } ], identification: [ { position: 10, label: 'Report Mode' } ] }
  @UI.selectionField: [ { position: 5 } ]
  ReportMode;

  // ---- Header block : always visible (mandatory in the original screen) ---
  @UI: { lineItem: [ { position: 50, label: 'Plant' } ], identification: [ { position: 50, label: 'Plant' } ] }
  @UI.selectionField: [ { position: 50 } ]
  Plant;

  @UI: { lineItem: [ { position: 60, label: 'Route' } ], identification: [ { position: 60, label: 'Route' } ] }
  @UI.selectionField: [ { position: 20 } ]
  Route;

  @UI: { lineItem: [ { position: 70, label: 'Settlement Date' } ], identification: [ { position: 70, label: 'Settlement Date' } ] }
  @UI.selectionField: [ { position: 30 } ]
  SettlementDate;

  // ---- Per-mode filters : shown/hidden by the ListReport controller ext ---
  @UI: { lineItem: [ { position: 20, label: 'Shipment / Visit List', importance: #HIGH } ], identification: [ { position: 20, label: 'Shipment / Visit List' } ] }
  @UI.selectionField: [ { position: 10 } ]
  ShipmentNo;

  @UI: { lineItem: [ { position: 80, label: 'Status' } ], identification: [ { position: 80, label: 'Status' } ] }
  @UI.selectionField: [ { position: 40 } ]
  StatusId;

  @UI: { lineItem: [ { position: 90, label: 'Customer' } ], identification: [ { position: 90, label: 'Customer' } ] }
  @UI.selectionField: [ { position: 60 } ]
  Customer;

  @UI: { lineItem: [ { position: 100, label: 'Material' } ], identification: [ { position: 100, label: 'Material' } ] }
