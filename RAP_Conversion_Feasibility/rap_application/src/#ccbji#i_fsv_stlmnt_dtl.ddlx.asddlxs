  @UI: { lineItem: [ { position: 213, label: 'Visit Group' } ], identification: [ { position: 213, label: 'Visit Group' } ] }
  VisitGroup;

  @UI: { lineItem: [ { position: 214, label: 'IDoc No.' } ], identification: [ { position: 214, label: 'IDoc No.' } ] }
  IDocNo;

  // ---- Visit Details extra columns (classic f_get_visit_details) ---------
  @UI: { lineItem: [ { position: 230, label: 'Distribution Channel' } ], identification: [ { position: 300, label: 'Distribution Channel' } ] }
  DistChannel;

  @UI: { lineItem: [ { position: 231, label: 'Division' } ], identification: [ { position: 301, label: 'Division' } ] }
  Division;

  @UI: { lineItem: [ { position: 232, label: 'Account Group' } ], identification: [ { position: 302, label: 'Account Group' } ] }
  AccountGroup;

  @UI: { lineItem: [ { position: 233, label: 'Business Type' } ], identification: [ { position: 303, label: 'Business Type' } ] }
  BusinessType;

  @UI: { lineItem: [ { position: 234, label: 'Equipment Owner' } ], identification: [ { position: 304, label: 'Equipment Owner' } ] }
  EquipOwner;

  @UI: { lineItem: [ { position: 235, label: 'Processing Indicator' } ], identification: [ { position: 305, label: 'Processing Indicator' } ] }
  ManProc;

  @UI: { lineItem: [ { position: 236, label: 'Visit Log Status' } ], identification: [ { position: 306, label: 'Visit Log Status' } ] }
  VisitLog;

  // ---- Option B: exact per-mode columns (Sales/Check/Payment/Money/Qty) ----
  @UI: { lineItem: [ { position: 240, label: 'Delivery Item' } ], identification: [ { position: 400, label: 'Delivery Item' } ] }
  DeliveryItem;

  @UI: { lineItem: [ { position: 241, label: 'PO Date' } ], identification: [ { position: 401, label: 'PO Date' } ] }
  PoDate;

  @UI: { lineItem: [ { position: 242, label: 'Transaction Code' } ], identification: [ { position: 402, label: 'Transaction Code' } ] }
  TaCode;

  @UI: { lineItem: [ { position: 243, label: 'Reason' } ], identification: [ { position: 403, label: 'Reason' } ] }
  Reason;

  @UI: { lineItem: [ { position: 244, label: 'Batch' } ], identification: [ { position: 404, label: 'Batch' } ] }
  Batch;

  @UI: { lineItem: [ { position: 245, label: 'Condition Type' } ], identification: [ { position: 405, label: 'Condition Type' } ] }
  CondType;

  @UI: { lineItem: [ { position: 246, label: 'Original Quantity' } ], identification: [ { position: 406, label: 'Original Quantity' } ] }
  OrigQty;

  @UI: { lineItem: [ { position: 247, label: 'Check ID' } ], identification: [ { position: 407, label: 'Check ID' } ] }
  CheckId;

  @UI: { lineItem: [ { position: 248, label: 'Item No.' } ], identification: [ { position: 408, label: 'Item No.' } ] }
  ItemNo;

  @UI: { lineItem: [ { position: 249, label: 'Planned Quantity' } ], identification: [ { position: 409, label: 'Planned Quantity' } ] }
  QuanPlan;

