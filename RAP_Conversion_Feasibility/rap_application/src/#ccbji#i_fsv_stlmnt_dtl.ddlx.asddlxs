  AmountCo;

  @UI: { lineItem: [ { position: 257, label: 'Amount Expenses' } ], identification: [ { position: 417, label: 'Amount Expenses' } ] }
  AmountExpenses;

  @UI: { lineItem: [ { position: 258, label: 'Amount Earnings' } ], identification: [ { position: 418, label: 'Amount Earnings' } ] }
  AmountEarnings;

  @UI: { lineItem: [ { position: 259, label: 'Amount Check-In' } ], identification: [ { position: 419, label: 'Amount Check-In' } ] }
  AmountCi;

  @UI: { lineItem: [ { position: 260, label: 'Amount Planned' } ], identification: [ { position: 420, label: 'Amount Planned' } ] }
  AmountPlan;

  @UI: { lineItem: [ { position: 261, label: 'Quantity Check-Out' } ], identification: [ { position: 421, label: 'Quantity Check-Out' } ] }
  QuanCheckout;

  @UI: { lineItem: [ { position: 262, label: 'Quantity Delivered' } ], identification: [ { position: 422, label: 'Quantity Delivered' } ] }
  QuanDelivered;

  @UI: { lineItem: [ { position: 263, label: 'Quantity Returned' } ], identification: [ { position: 423, label: 'Quantity Returned' } ] }
  QuanReturn;

  @UI: { lineItem: [ { position: 264, label: 'Quantity Check-In' } ], identification: [ { position: 424, label: 'Quantity Check-In' } ] }
  QuanCheckin;

  @UI: { lineItem: [ { position: 265, label: 'Quantity Final Diff.' } ], identification: [ { position: 425, label: 'Quantity Final Diff.' } ] }
  QuanFinalDiff;

  @UI: { lineItem: [ { position: 266, label: 'Value Final Diff.' } ], identification: [ { position: 426, label: 'Value Final Diff.' } ] }
  ValueFinDiff;

  // ---- Payment FI posting detail (from CDS, replacing FI_DOCUMENT_READ) ----
  @UI: { lineItem: [ { position: 267, label: 'Posting Item' } ], identification: [ { position: 427, label: 'Posting Item' } ] }
  PostingItem;

  @UI: { lineItem: [ { position: 268, label: 'Posting Amount' } ], identification: [ { position: 428, label: 'Posting Amount' } ] }
  PostingAmount;

  @UI: { lineItem: [ { position: 269, label: 'Posting Currency' } ], identification: [ { position: 429, label: 'Posting Currency' } ] }
