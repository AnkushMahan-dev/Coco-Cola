@Metadata.layer: #CORE
@UI: { headerInfo: { typeName:       'Settlement Detail',
                     typeNamePlural: 'Settlement Details',
                     title:          { type: #STANDARD, value: 'ShipmentNo' } } }
annotate entity /CCBJI/I_FSV_STLMNT_DTL with
{
  @UI.facet: [ { id: 'Gen', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
                 label: 'Settlement Detail', position: 10 } ]

  @UI.hidden: true
  RowKey;

  @UI.hidden: true
  Seqno;

  // Explicit column labels on every lineItem: on a CUSTOM ENTITY the element
  // @EndUserText.label does not reliably become the MDC table column header,
  // so each header text is set here directly (that was the "blank Status /
  // blank column" cause on the list page).

  // ---- Report Mode : the driving dropdown (classic radio group) ----------
  @UI: { lineItem: [ { position: 10, label: 'Report Mode', importance: #HIGH } ], identification: [ { position: 10, label: 'Report Mode' } ] }
  @UI.selectionField: [ { position: 5 } ]
  ReportMode;

  // ---- Header block : always visible (mandatory in the original screen) ---
  @UI: { lineItem: [ { position: 50, label: 'Plant' } ], identification: [ { position: 50, label: 'Plant' } ] }
  @UI.selectionField: [ { position: 50 } ]
  Plant;

  @UI: { lineItem: [ { position: 60, label: 'Route' } ], identification: [ { position: 60, label: 'Route' } ] }
  @UI.selectionField: [ { position: 20 } ]
  Route;

  @UI: { lineItem: [ { position: 70, label: 'Settlement Date' } ], identification: [ { position: 70, label: 'Settlement Date' } ] }
  @UI.selectionField: [ { position: 30 } ]
  SettlementDate;

  // ---- Per-mode filters : shown/hidden by the ListReport controller ext ---
  @UI: { lineItem: [ { position: 20, label: 'Shipment / Visit List', importance: #HIGH } ], identification: [ { position: 20, label: 'Shipment / Visit List' } ] }
  @UI.selectionField: [ { position: 10 } ]
  ShipmentNo;

  @UI: { lineItem: [ { position: 80, label: 'Status' } ], identification: [ { position: 80, label: 'Status' } ] }
  @UI.selectionField: [ { position: 40 } ]
  StatusId;

  @UI: { lineItem: [ { position: 90, label: 'Customer' } ], identification: [ { position: 90, label: 'Customer' } ] }
  @UI.selectionField: [ { position: 60 } ]
  Customer;

  @UI: { lineItem: [ { position: 100, label: 'Material' } ], identification: [ { position: 100, label: 'Material' } ] }
  @UI.selectionField: [ { position: 70 } ]
  Material;

  @UI: { lineItem: [ { position: 110, label: 'Material Description' } ], identification: [ { position: 110, label: 'Material Description' } ] }
  MaterialDesc;

  @UI: { lineItem: [ { position: 120, label: 'Quantity' } ], identification: [ { position: 120, label: 'Quantity' } ] }
  Quantity;

  @UI: { lineItem: [ { position: 130, label: 'Quantity Difference' } ], identification: [ { position: 130, label: 'Quantity Difference' } ] }
  QuanDiff;

  @UI: { lineItem: [ { position: 140, label: 'Amount' } ], identification: [ { position: 140, label: 'Amount' } ] }
  Amount;

  @UI: { lineItem: [ { position: 150, label: 'Currency' } ], identification: [ { position: 150, label: 'Currency' } ] }
  @UI.selectionField: [ { position: 170 } ]
  Currency;

  @UI: { lineItem: [ { position: 160, label: 'Payment Method' } ], identification: [ { position: 160, label: 'Payment Method' } ] }
  @UI.selectionField: [ { position: 80 } ]
  PaymentMethod;

  @UI: { lineItem: [ { position: 170, label: 'Settlement Doc.' } ], identification: [ { position: 170, label: 'Settlement Doc.' } ] }
  @UI.selectionField: [ { position: 160 } ]
  SldDocId;

  @UI: { lineItem: [ { position: 180, label: 'Delivery No.' } ], identification: [ { position: 180, label: 'Delivery No.' } ] }
  @UI.selectionField: [ { position: 150 } ]
  DeliveryNo;

  @UI: { lineItem: [ { position: 190, label: 'Driver' } ], identification: [ { position: 190, label: 'Driver' } ] }
  @UI.selectionField: [ { position: 90 } ]
  Driver;

  @UI: { identification: [ { position: 200, label: 'Vehicle' } ] }
  @UI.selectionField: [ { position: 100 } ]
  Vehicle;

  @UI: { lineItem: [ { position: 215, label: 'Visit ID' } ], identification: [ { position: 210, label: 'Visit ID' } ] }
  @UI.selectionField: [ { position: 120 } ]
  VisitId;

  @UI: { lineItem: [ { position: 200, label: 'Tour ID' } ], identification: [ { position: 220, label: 'Tour ID' } ] }
  @UI.selectionField: [ { position: 130 } ]
  TourId;

  @UI: { lineItem: [ { position: 216, label: 'Sales Organization' } ], identification: [ { position: 230, label: 'Sales Organization' } ] }
  @UI.selectionField: [ { position: 110 } ]
  Vkorg;

  @UI: { lineItem: [ { position: 217, label: 'Cash Type' } ], identification: [ { position: 240, label: 'Cash Type' } ] }
  @UI.selectionField: [ { position: 140 } ]
  CashType;

  @UI: { lineItem: [ { position: 218, label: 'Visit Reason' } ], identification: [ { position: 250, label: 'Visit Reason' } ] }
  @UI.selectionField: [ { position: 180 } ]
