  @UI: { lineItem: [ { position: 220, label: 'Reference Document' } ], identification: [ { position: 270, label: 'Reference Document' } ] }
  ReferenceDoc;

  @UI: { lineItem: [ { position: 221, label: 'PO Number' } ], identification: [ { position: 280, label: 'PO Number' } ] }
  PoNumber;

  @UI: { lineItem: [ { position: 222, label: 'Card Number' } ], identification: [ { position: 290, label: 'Card Number' } ] }
  CardNo;

  // ---- Tour Details columns (classic f_get_driver_details) ---------------
  // Exception traffic light as a readable, colour-coded column (classic ALV
  // exception column). Coloured by the Light criticality.
  @UI: { lineItem:       [ { position: 34, label: 'Exception', criticality: 'Light' } ],
         identification: [ { position: 34, label: 'Exception', criticality: 'Light' } ] }
  ExceptionText;

  // Processing status coloured by the Exception traffic light (Light).
  @UI: { lineItem:       [ { position: 35, label: 'Processing Status', criticality: 'Light' } ],
         identification: [ { position: 35, label: 'Processing Status', criticality: 'Light' } ] }
  ProcessingStatus;

  @UI: { lineItem: [ { position: 195, label: 'Co-Driver' } ], identification: [ { position: 195, label: 'Co-Driver' } ] }
